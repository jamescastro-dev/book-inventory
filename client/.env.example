# Copy this file to client/.env. Vite inlines these values at build time,
# so restart `npm run dev` (or rebuild) after changing them.

# Base URL of the Django backend (no trailing slash)
VITE_API_URL=http://localhost:8000
VITE_API_BOOKS_URL=http://localhost:8000/api
VITE_API_AUTH_URL=http://localhost:8000/api/auth
