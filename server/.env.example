# Copy this file to server/.env and fill it in. Never commit the real .env.

# Required. The app refuses to start without it. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True for local development, False in production.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Leave blank to use a local SQLite file (server/db.sqlite3).
# In production this is the Postgres connection string (hosted on Neon).
# CAUTION: if you point this at a hosted database, migrate/seed/test act on it.
DATABASE_URL=

# Cloudinary stores and serves the book cover images (a free account is enough).
# All three must be non-empty or any request that returns a book cover fails
# with ImproperlyConfigured. To only browse locally you can use placeholders
# for the key and secret; uploading a new cover needs real credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
